<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Security boundary: independently verify every shared-UID owner, including
         arbitrary third-party clients. A fixed queries list cannot cover them. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <application android:label="Kizuku" android:icon="@drawable/ic_kizuku"
        android:theme="@style/Theme.Kizuku" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name=".CoreProvider" android:authorities="io.github.stupidgiraffe.kizuku.core" android:exported="true" />
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
        <receiver android:name=".LegacyBinderRequestReceiver" android:exported="true">
            <intent-filter><action android:name="io.github.stupidgiraffe.kizuku.REQUEST_LEGACY" /></intent-filter>
        </receiver>
    </application>
</manifest>
